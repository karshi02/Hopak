generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  OWNER
  ADMIN
}

model SiteSettings {
  id           String   @id
  heroImageUrl String?
  posterUrls   String[] @default([])
  // รูปพื้นหลังการ์ด "ทำเลยอดนิยม" หน้าแรก ผูกกับชื่อจังหวัด — { "มหาสารคาม": "https://..." }
  areaImages   Json     @default("{}")
  // การ์ดจุดขาย 3 ใบใต้ hero หน้าแรก — array [{ tagTh,titleTh,subTh,tagEn,titleEn,subEn }]
  // ว่าง = ใช้ข้อความ default ที่ hardcode ในหน้าเว็บ (ไม่บังคับให้แอดมินตั้งก่อนถึงจะโชว์)
  promoCards   Json     @default("[]")
  // ข้อความหน้าแรกที่แอดมินแก้ไขได้แบบ inline — { heroTitleTh, heroSubtitleTh, zonesTitleTh, zonesSubTh, trust:[{titleTh,subTh}] }
  // ว่าง = ใช้ข้อความ default ที่ hardcode ในหน้าเว็บ (แอดมินแก้เฉพาะภาษาไทย อังกฤษใช้ default)
  homeContent  Json     @default("{}")
  // อัตราค่าคอมที่แอดมินปรับได้เอง (เก็บเป็นสัดส่วน 0-1 ไม่ใช่เปอร์เซ็นต์)
  // ว่าง = ใช้ค่า default จาก packages/shared (กันเคส DB ยังไม่เคยตั้งค่า)
  // ค่าที่คิดไปแล้วเก็บลง Payment ทุกใบ การแก้ตรงนี้จึงมีผลกับบิลใหม่เท่านั้น ไม่ย้อนหลัง
  commissionRate      Float?
  dailyCommissionRate Float?
  updatedAt    DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
}

enum DormStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoomType {
  AIR
  FAN
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
  COMPLETED
}

// รูปแบบการเช่า: รายเดือน (สัญญาเช่า) หรือ รายวัน (จองเป็นช่วงวัน แบบโรงแรม/Airbnb)
enum RentalType {
  MONTHLY
  DAILY
}

enum PaymentStatus {
  PENDING
  SETTLED
  TRANSFERRED
}

enum CampaignKind {
  BOOST
  BANNER
  FEATURED
}

enum OwnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  role      Role
  name      String
  // อีเมล/เบอร์/googleId ไม่ unique เดี่ยวๆ อีกต่อไป — unique คู่กับ role แทน
  // เพราะคนเดียวกันมีได้ทั้งบัญชี "ผู้เช่า" และบัญชี "เจ้าของหอ" ด้วยอีเมลเดียวกัน แต่ข้อมูลแยกขาดจากกัน
  email     String?
  phone     String?
  password  String?
  avatarUrl String?
  address   String?
  googleId  String?
  suspended Boolean  @default(false)

  // ยืนยันตัวตนด้วย OTP ทางอีเมล (ผู้ใช้กดยืนยันเองจากหน้าโปรไฟล์)
  emailVerified Boolean   @default(false)
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpSentAt     DateTime?
  otpAttempts   Int       @default(0)

  // รีเซ็ตรหัสผ่านทางอีเมล — เก็บแค่ sha256 ของ token ตัวจริงอยู่ในลิงก์ที่ส่งไปอีเมลเท่านั้น
  // (sha256 ไม่ใช่ bcrypt เพราะต้อง lookup ด้วย hash ตรงๆ ตอน user กดลิงก์กลับมา
  //  token เป็น random 32 bytes อยู่แล้ว ไม่มีทาง brute-force เหมือนรหัสผ่านที่คนตั้งเอง)
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  resetTokenSentAt    DateTime?

  // ข้อมูลบัญชีรับเงินของเจ้าของหอ — ใช้ตอนแอดมินโอนยอด payout ให้
  // bankAccountName แยกจาก name เจ้าของบัญชี (อาจไม่ตรงกัน เช่น บัญชีธุรกิจ/ให้คนอื่นถือแทน)
  // แอดมินต้องเห็นชื่อนี้คู่กับเลขบัญชีก่อนโอนทุกครั้ง กันโอนผิดคน
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  promptpayId       String?
  // เอกสารยืนยันตัวตนระดับบัญชี (ไม่ผูกกับหอพักใดหอพักหนึ่ง) — เก็บเป็น storage key ส่วนตัว
  // ใช้เมื่อแอดมินสร้างบัญชีเจ้าของหอให้เองโดยตรง เพิ่ม/เปลี่ยนได้ตลอดหลังสร้างบัญชีแล้ว
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dorms         Dorm[]
  bookings      Booking[]
  notifications Notification[]
  admin         Admin?
  reviews       Review[]
  favorites     Favorite[]
  ownerRequests OwnerRequest[]
  approvalLogs  ApprovalLog[]
  sessions      Session[]

  @@unique([email, role])
  @@unique([phone, role])
  @@unique([googleId, role])
  @@index([resetTokenHash])
}

// อุปกรณ์ที่เข้าสู่ระบบ — บันทึกทุกครั้งที่ login สำเร็จ (register/login/google) เพื่อโชว์ประวัติ
// และเตะออกจากอุปกรณ์นั้นได้จริง (jti ผูกกับ JWT ที่ออกไป, JwtStrategy เช็ค revokedAt ทุก request)
model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  jti        String    @unique
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
}

model Dorm {
  id            String     @id @default(cuid())
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id])
  name          String
  description   String
  address       String?
  province      String
  university    String?
  lat           Float
  lng           Float
  waterRate     Float
  electricRate  Float
  deposit       Float
  amenities     Json
  images        String[]
  documents     String[]   @default([])
  status        DormStatus @default(PENDING_APPROVAL)
  // เหตุผลที่แอดมินปฏิเสธล่าสุด (สาเหตุ + วิธีแก้) โชว์ให้เจ้าของหอเห็นเพื่อแก้แล้วส่งใหม่
  rejectionReason String?
  // จำนวนครั้งที่ถูกปฏิเสธ — ครบ 3 ครั้งแอดมินสั่งระงับได้ทันที
  rejectionCount  Int      @default(0)
  // ถ้า true ห้องใหม่ที่เจ้าของหอนี้เพิ่มจะโชว์ให้ผู้เช่าเห็นทันทีไม่ต้องรอแอดมินตรวจ (แอดมินปรับได้ทุกเมื่อ)
  autoApproveRooms Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  rooms      Room[]
  campaigns  Campaign[]
  reviews    Review[]
  favorites  Favorite[]
}

model Room {
  id            String     @id @default(cuid())
  dormId        String
  dorm          Dorm       @relation(fields: [dormId], references: [id])
  type          RoomType
  pricePerMonth Float
  // ราคาต่อคืนสำหรับเช่ารายวัน — ใช้เมื่อ allowDaily = true เท่านั้น
  pricePerDay   Float      @default(0)
  // เจ้าของหอเปิดให้ห้องนี้จองรายวันได้หรือไม่ (ปิดโดย default — คงพฤติกรรมเดิมเป็นรายเดือน)
  allowDaily    Boolean    @default(false)
  status        RoomStatus @default(AVAILABLE)
  // จองชั่วคราวระหว่างผู้เช่ากำลังชำระเงิน (hold) — กันคนอื่นจ่ายห้องเดียวกันซ้อน
  // heldUntil > now = ห้องถูกล็อกให้ heldByBookingId คนเดียวจ่ายได้ ; เกินเวลา = ปล่อยคืน (cron)
  heldUntil       DateTime?
  heldByBookingId String?

  name          String?
  description   String?
  deposit       Float      @default(0)
  waterRate     Float      @default(0)
  electricRate  Float      @default(0)
  amenities     String[]   @default([])
  images        String[]   @default([])
  // false = รอแอดมินตรวจสอบก่อนโชว์ให้ผู้เช่าเห็น (ตามค่า dorm.autoApproveRooms ตอนสร้าง)
  approved      Boolean    @default(true)

  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         User          @relation(fields: [tenantId], references: [id])
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id])
  checkInDate    DateTime
  // วันคืนห้อง — ใช้เฉพาะเช่ารายวัน (rentalType = DAILY) เพื่อคิดจำนวนคืน + กันจองซ้ำช่วงวันชนกัน
  checkOutDate   DateTime?
  amount         Float         // ยอดที่ผู้เช่าจ่ายรวม = roomPrice + deposit
  roomPrice      Float         @default(0) // ค่าเช่าห้อง snapshot ตอนจอง — ฐานคิดค่าคอม
  deposit        Float         @default(0) // ค่ามัดจำ snapshot ตอนจอง — ส่งเจ้าของเต็ม ไม่โดนหักคอม
  rentalType     RentalType    @default(MONTHLY) // รายเดือน หรือ รายวัน
  leaseMonths    Int           @default(1) // ระยะเวลาเช่าที่ผู้เช่าเลือก (เดือน) — 1/3/6 (เฉพาะรายเดือน)
  nights         Int?          // จำนวนคืน (เฉพาะรายวัน) = checkOutDate - checkInDate
  guests         Int?          // จำนวนผู้เข้าพัก (เฉพาะรายวัน) — เจ้าของหอเตรียมห้องได้ถูก
  status         BookingStatus @default(PENDING)
  contactName    String
  contactPhone   String
  note           String?
  cancelDeadline DateTime
  // เส้นตายชำระเงิน (hold) — ตั้งตอนกดจ่าย (createCharge) = now+10 นาที ; เกินแล้วไม่จ่าย cron คืนห้อง+ยกเลิก
  paymentDeadline DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // โทเค็นยืนยันตัวตนตอนเข้าพักจริง — ออกให้ตอนแอดมินเคลียร์บิล (จังหวะที่ใบเสร็จเกิดขึ้น)
  // ผู้เช่าเอาโค้ดนี้จากใบเสร็จไปให้เจ้าของหอกรอกในระบบตอนเข้าพัก เพื่อปิดงานเป็น COMPLETED
  // เห็นได้เฉพาะผู้เช่าเจ้าของการจองเท่านั้น — เจ้าของหอต้องถูก "แสดง" โค้ดตัวเป็นๆ ไม่ใช่อ่านเองจากระบบ
  checkInToken          String?   @unique
  checkInTokenExpiresAt DateTime?
  checkedInAt           DateTime?

  payment Payment?
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amount        Float
  commission    Float
  chamberShare  Float         @default(0)
  platformShare Float         @default(0)
  ownerPayout   Float
  method        String
  status        PaymentStatus @default(PENDING)
  slipKey       String?
  // เลขอ้างอิงธุรกรรมจากสลิป (SlipOK) — unique กันเอาสลิปเดิมมาจ่ายซ้ำหลาย booking
  slipTransRef  String?       @unique
  // id ของ charge/QR ฝั่ง payment gateway (Xendit) — ใช้ผูก webhook กลับมาหา payment นี้
  gatewayChargeId String?     @unique
  // payload EMV ของ QR — เก็บไว้คืน QR "ตัวเดิม" ตอนผู้ใช้รีเฟรชหน้าชำระเงิน
  // ไม่งั้นต้องยิงสร้าง QR ใหม่ทุกครั้ง = ต่ออายุ hold ห้องไปเรื่อยๆ + ถล่ม API ของ gateway
  gatewayQrString String?
  settledAt     DateTime?
  createdAt     DateTime      @default(now())

  // สลิปที่แอดมินโอนเงิน payout ให้เจ้าของหอ (คนละสลิปกับ slipKey ของลูกค้า)
  transferSlipKey String?
  transferredAt   DateTime?

  // การโอนออกผ่าน Xendit Payouts — เก็บไว้ผูก webhook กลับมาหา payment ที่โอนรอบนี้
  // ถ้าโอนล้มเหลว/ตีกลับ webhook จะดึงสถานะกลับมาเป็นรอโอนใหม่ ไม่ค้างเป็น TRANSFERRED ทั้งที่เงินไม่ถึง
  payoutId     String?
  payoutRef    String?
  payoutStatus String?
  payoutFailedReason String?

  @@index([payoutId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  // เก็บ storage key ของไฟล์แนบ (เช่น สลิปโอนเงิน payout) — private key เท่านั้น ต้องขอ signed URL
  // ใหม่ทุกครั้งผ่าน endpoint แยก ไม่ผูก URL ถาวรไว้ตรงนี้ (URL หมดอายุ 15 นาที)
  attachmentKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Campaign {
  id      String       @id @default(cuid())
  dormId  String
  dorm    Dorm         @relation(fields: [dormId], references: [id])
  kind    CampaignKind
  startAt DateTime
  endAt   DateTime
  price   Float
}

model Admin {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  adminRole AdminRole
}

model OwnerRequest {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  status    OwnerRequestStatus @default(PENDING)
  // ข้อมูลที่ผู้ขอกรอกให้แอดมินตรวจก่อนอนุมัติเป็นเจ้าของหอ
  phone     String?
  dormName  String?
  province  String?
  address   String?
  note      String?
  // เอกสารยืนยัน (บัตรประชาชน/โฉนด/ทะเบียนบ้าน) เก็บเป็น storage key (private)
  documents String[]           @default([])
  createdAt DateTime           @default(now())
  decidedAt DateTime?
}

enum OwnerApplicationStatus {
  DRAFT
  EMAIL_VERIFIED
  COMPLETED
}

// ใบสมัครเปิดหอพัก (ก่อนมีบัญชีจริง) — เก็บข้อมูลบัญชี+หอพักระหว่างกรอกฟอร์มหลายขั้นตอน
// จนกว่าจะยืนยันอีเมลด้วย OTP และตั้งรหัสผ่านเสร็จ ถึงจะสร้าง User/Dorm จริงใน finish()
model OwnerApplication {
  id           String                  @id @default(cuid())
  status       OwnerApplicationStatus  @default(DRAFT)
  name         String?
  email        String                  @unique
  phone        String?

  dormName     String?
  address      String?
  province     String?
  lat          Float?
  lng          Float?
  waterRate    Float?
  electricRate Float?
  deposit      Float?
  note         String?
  images       String[]                @default([])
  documents    String[]                @default([])
  rooms        Json?

  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpSentAt    DateTime?
  otpAttempts  Int                     @default(0)
  verifiedAt   DateTime?

  // ความลับสำหรับทำงานต่อกับใบสมัครนี้ (continuation secret) — เก็บเฉพาะ sha256
  // id อย่างเดียวไม่พอเป็นหลักฐานความเป็นเจ้าของ เพราะ start() ด้วยอีเมลของคนอื่นก็ได้ id เดิมกลับไป
  secretHash        String?
  // secret ตัวที่ยืนยัน OTP สำเร็จ — finish ต้องมาจากตัวเดียวกันเท่านั้น
  // (กันคนอื่นแข่งกด finish หลังเจ้าตัวยืนยันอีเมลแล้ว)
  verifiedSecretHash String?

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id])
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
  rating    Int
  comment   String?
  // เจ้าของหอตอบกลับรีวิวผู้เช่าได้ (ไม่ใช่การเขียนรีวิวปลอมให้ตัวเอง — รีวิวยังเป็นของผู้เช่าคนเดิม แค่มีคำตอบกลับติดไว้)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([dormId, tenantId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dormId])
}

// ประวัติการอนุมัติ/ปฏิเสธ/แก้ไข/ระงับ ของแอดมิน — ใช้ตรวจสอบย้อนหลังกันทุจริต
// snapshot เก็บข้อมูล entity ทั้งก้อน ณ ตอนนั้น จำเป็นมากสำหรับ ROOM เพราะแถวจริงถูกลบทิ้งหลัง reject
model ApprovalLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  snapshot   Json?
  note       String?
  createdAt  DateTime @default(now())
}

/// สถานที่สำคัญ/ท่องเที่ยว ที่ดึงมาจาก Google Places แล้วเก็บไว้ใช้ซ้ำ
/// เก็บลง DB เพราะ Places คิดเงินต่อครั้งที่เรียก — หน้าแรกมีคนเข้าตลอด ยิงสดทุกครั้งไม่ไหว
/// รูปก็โหลดมาเก็บเป็นไฟล์ของเราเองตอน sync ครั้งเดียว ไม่ proxy ไปหา Google ทุกครั้งที่มีคนเปิดหน้า
model Landmark {
  id        String   @id @default(cuid())
  /// place_id ของ Google — กันเก็บซ้ำเวลา sync รอบใหม่
  placeId   String   @unique
  name      String
  province  String
  /// อำเภอที่จับได้จากที่อยู่ — ใช้ผูกกับหอพักในอำเภอเดียวกัน
  district  String
  address   String?
  lat       Float
  lng       Float
  /// URL รูปที่เราเก็บเอง (โหลดจาก Places Photo ตอน sync)
  imageUrl  String?
  rating    Float?
  /// อันดับการโชว์ — เรียงจากคะแนน/จำนวนรีวิวตอน sync
  sortOrder Int      @default(0)
  syncedAt  DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([province, district])
}
