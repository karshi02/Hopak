generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TENANT
  OWNER
  ADMIN
}

model SiteSettings {
  id           String   @id
  heroImageUrl String?
  posterUrls   String[] @default([])
  // รูปพื้นหลังการ์ด "ทำเลยอดนิยม" หน้าแรก ผูกกับชื่อจังหวัด — { "มหาสารคาม": "https://..." }
  areaImages   Json     @default("{}")
  updatedAt    DateTime @updatedAt
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  FINANCE
  SUPPORT
}

enum DormStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED
}

enum RoomType {
  AIR
  FAN
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SETTLED
  TRANSFERRED
}

enum CampaignKind {
  BOOST
  BANNER
  FEATURED
}

enum OwnerRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  role      Role
  name      String
  email     String?  @unique
  phone     String?  @unique
  password  String?
  avatarUrl String?
  address   String?
  googleId  String?  @unique
  suspended Boolean  @default(false)

  // ยืนยันตัวตนด้วย OTP ทางอีเมล (ผู้ใช้กดยืนยันเองจากหน้าโปรไฟล์)
  emailVerified Boolean   @default(false)
  otpCodeHash   String?
  otpExpiresAt  DateTime?
  otpSentAt     DateTime?
  otpAttempts   Int       @default(0)

  // ข้อมูลบัญชีรับเงินของเจ้าของหอ — ใช้ตอนแอดมินโอนยอด payout ให้
  bankName          String?
  bankAccountNumber String?
  promptpayId       String?
  // เอกสารยืนยันตัวตนระดับบัญชี (ไม่ผูกกับหอพักใดหอพักหนึ่ง) — เก็บเป็น storage key ส่วนตัว
  // ใช้เมื่อแอดมินสร้างบัญชีเจ้าของหอให้เองโดยตรง เพิ่ม/เปลี่ยนได้ตลอดหลังสร้างบัญชีแล้ว
  documents String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dorms         Dorm[]
  bookings      Booking[]
  notifications Notification[]
  admin         Admin?
  reviews       Review[]
  favorites     Favorite[]
  ownerRequests OwnerRequest[]
  approvalLogs  ApprovalLog[]
}

model Dorm {
  id            String     @id @default(cuid())
  ownerId       String
  owner         User       @relation(fields: [ownerId], references: [id])
  name          String
  description   String
  address       String?
  province      String
  university    String?
  lat           Float
  lng           Float
  waterRate     Float
  electricRate  Float
  deposit       Float
  amenities     Json
  images        String[]
  documents     String[]   @default([])
  status        DormStatus @default(PENDING_APPROVAL)
  // ถ้า true ห้องใหม่ที่เจ้าของหอนี้เพิ่มจะโชว์ให้ผู้เช่าเห็นทันทีไม่ต้องรอแอดมินตรวจ (แอดมินปรับได้ทุกเมื่อ)
  autoApproveRooms Boolean @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  rooms      Room[]
  campaigns  Campaign[]
  reviews    Review[]
  favorites  Favorite[]
}

model Room {
  id            String     @id @default(cuid())
  dormId        String
  dorm          Dorm       @relation(fields: [dormId], references: [id])
  type          RoomType
  pricePerMonth Float
  status        RoomStatus @default(AVAILABLE)

  name          String?
  description   String?
  deposit       Float      @default(0)
  waterRate     Float      @default(0)
  electricRate  Float      @default(0)
  amenities     String[]   @default([])
  images        String[]   @default([])
  // false = รอแอดมินตรวจสอบก่อนโชว์ให้ผู้เช่าเห็น (ตามค่า dorm.autoApproveRooms ตอนสร้าง)
  approved      Boolean    @default(true)

  bookings Booking[]
}

model Booking {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         User          @relation(fields: [tenantId], references: [id])
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id])
  checkInDate    DateTime
  amount         Float
  status         BookingStatus @default(PENDING)
  contactName    String
  contactPhone   String
  note           String?
  cancelDeadline DateTime
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  payment Payment?
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String        @unique
  booking       Booking       @relation(fields: [bookingId], references: [id])
  amount        Float
  commission    Float
  chamberShare  Float         @default(0)
  platformShare Float         @default(0)
  ownerPayout   Float
  method        String
  status        PaymentStatus @default(PENDING)
  slipKey       String?
  settledAt     DateTime?
  createdAt     DateTime      @default(now())

  // สลิปที่แอดมินโอนเงิน payout ให้เจ้าของหอ (คนละสลิปกับ slipKey ของลูกค้า)
  transferSlipKey String?
  transferredAt   DateTime?
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Campaign {
  id      String       @id @default(cuid())
  dormId  String
  dorm    Dorm         @relation(fields: [dormId], references: [id])
  kind    CampaignKind
  startAt DateTime
  endAt   DateTime
  price   Float
}

model Admin {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  adminRole AdminRole
}

model OwnerRequest {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  status    OwnerRequestStatus @default(PENDING)
  createdAt DateTime           @default(now())
  decidedAt DateTime?
}

enum OwnerApplicationStatus {
  DRAFT
  EMAIL_VERIFIED
  COMPLETED
}

// ใบสมัครเปิดหอพัก (ก่อนมีบัญชีจริง) — เก็บข้อมูลบัญชี+หอพักระหว่างกรอกฟอร์มหลายขั้นตอน
// จนกว่าจะยืนยันอีเมลด้วย OTP และตั้งรหัสผ่านเสร็จ ถึงจะสร้าง User/Dorm จริงใน finish()
model OwnerApplication {
  id           String                  @id @default(cuid())
  status       OwnerApplicationStatus  @default(DRAFT)
  name         String?
  email        String                  @unique
  phone        String?

  dormName     String?
  address      String?
  province     String?
  lat          Float?
  lng          Float?
  waterRate    Float?
  electricRate Float?
  deposit      Float?
  note         String?
  images       String[]                @default([])
  documents    String[]                @default([])
  rooms        Json?

  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpSentAt    DateTime?
  otpAttempts  Int                     @default(0)
  verifiedAt   DateTime?

  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id])
  tenantId  String
  tenant    User     @relation(fields: [tenantId], references: [id])
  rating    Int
  comment   String?
  // เจ้าของหอตอบกลับรีวิวผู้เช่าได้ (ไม่ใช่การเขียนรีวิวปลอมให้ตัวเอง — รีวิวยังเป็นของผู้เช่าคนเดิม แค่มีคำตอบกลับติดไว้)
  reply     String?
  repliedAt DateTime?
  createdAt DateTime @default(now())

  @@unique([dormId, tenantId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  dormId    String
  dorm      Dorm     @relation(fields: [dormId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, dormId])
}

// ประวัติการอนุมัติ/ปฏิเสธ/แก้ไข/ระงับ ของแอดมิน — ใช้ตรวจสอบย้อนหลังกันทุจริต
// snapshot เก็บข้อมูล entity ทั้งก้อน ณ ตอนนั้น จำเป็นมากสำหรับ ROOM เพราะแถวจริงถูกลบทิ้งหลัง reject
model ApprovalLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  adminId    String
  admin      User     @relation(fields: [adminId], references: [id])
  snapshot   Json?
  note       String?
  createdAt  DateTime @default(now())
}
