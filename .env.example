# ตรวจสลิปการชำระเงิน (Slip Verify) — stub = ไม่เช็คธนาคาร (dev, แค่บังคับแนบสลิป) | slipok = เช็คจริงผ่าน SlipOK
PAYMENT_VERIFY_MODE=stub
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# ชื่อบัญชีผู้รับ (บางส่วน) ไว้ match กับสลิป กันแนบสลิปที่โอนไปบัญชีอื่น — เว้นว่าง = ไม่เช็คชื่อ
PAYMENT_RECEIVER_NAME=

# Payment gateway — Xendit (PromptPay QR). ดึง key จาก dashboard.xendit.co (test: xnd_development_...)
